PORT=8000
# Same Neon/Postgres database used by server-core
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Z.AI (https://api.z.ai) — backs every structured/background LLM feature:
# grievance analysis, draft emails/alerts, report analysis, task productivity
# insight, and AI Agents narration. Heera's interactive chat runs on
# OpenRouter instead (see OPENROUTER_MODEL below), not Z.AI.
ZAI_API_KEY=replace-with-your-zai-api-key
ZAI_MODEL=glm-4.7-flash
# Optional fallback if Z.AI errors (auth/quota/network) — a local Ollama
# model backs the structured/background calls, OpenRouter backs the
# chatbot. Leave unset to have those features simply degrade to their
# deterministic fallback text/error instead.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Must match server-core's JWT_SECRET exactly — used to identify the logged-in
# employee so the copilot can answer personal questions (leave balance, etc.)
JWT_SECRET=replace-with-a-long-random-string
