# =============================================================================
# kb-extract-rig .gitignore  — keep the repo to CODE + DOCS + real samples + gold.
# Everything below is transient (regenerated by a run), a cache, a secret, or an env.
# =============================================================================

# --- transient extraction OUTPUTS (recreated by every run) -------------------
out/
out_*/
sched_out/
sched_out*/
*_time_out/
*.done                       # atomic-write completion sentinels

# --- reconcile / calibration run-state (produced per run) --------------------
*.reconcile.json
reconcile_queue.csv
calibration.json

# --- machine-generated EVAL artifacts (the WRITTEN reviews 00_*..05_*, *_REPORT,
#     *_ROADMAP, SERVER_RUNBOOK, INDEX in eval/reports ARE kept as docs) --------
eval/reports/benchmark_*.json
eval/reports/benchmark_*.md
eval/reports/engine_compare*.json
eval/reports/engine_compare*.md
eval/reports/scanned_side_by_side.md
eval/reports/confidence.*

# --- generated test fixtures (recreate with eval/make_scanned_boq.py) ---------
samples/synthetic_*

# --- python caches / build / tooling -----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# --- virtual environments (rebuild with setup_server.sh) ---------------------
venv/
.venv/
env/
ENV/
kbe/
paddle-venv/

# --- SECRETS / KEYS — never commit -------------------------------------------
*.pem
*.key
*.p12
.env
.env.*
secrets*
credentials*
*_key.json
aws_credentials*

# --- logs --------------------------------------------------------------------
*.log
run.log.jsonl
run_log.jsonl
_errors.json

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.bak
*.tmp
.vscode/
.idea/
